private static HashSet<Vector2Int> CastLight(HashSet<Vector2Int> passables, Vector2Int origin, float viewRadius)
{
    HashSet<Vector2Int> visiblePoints = new HashSet<Vector2Int>();
    int radius = Mathf.CeilToInt(viewRadius);

    for (int i = -radius; i <= radius; i++)
    {
        for (int j = -radius; j <= radius; j++)
        {
            if (i * i + j * j < radius * radius)
            {
                LineOfSight(origin, new Vector2Int(origin.x + i, origin.y + j), passables, visiblePoints);
            }
        }
    }

    return visiblePoints;
}

private static void LineOfSight(Vector2Int start, Vector2Int end, HashSet<Vector2Int> passables, HashSet<Vector2Int> visiblePoints)
{
    int dx = end.x - start.x;
    int dy = end.y - start.y;
    int sx = (start.x < end.x) ? 1 : -1;
    int sy = (start.y < end.y) ? 1 : -1;

    int x = start.x;
    int y = start.y;

    float dist = Mathf.Sqrt(dx * dx + dy * dy);

    while (x != end.x || y != end.y)
    {
        if (!passables.Contains(new Vector2Int(x, y)))
        {
            visiblePoints.Add(new Vector2Int(x, y)); // 壁を記憶する
            return;
        }

        if (Mathf.Abs(dy * (x - start.x + sx) - dx * (y - start.y)) / dist < 0.5f)
            x += sx;
        else if (Mathf.Abs(dy * (x - start.x) - dx * (y - start.y + sy)) / dist < 0.5f)
            y += sy;
        else
        {
            x += sx;
            y += sy;
        }
    }
    visiblePoints.Add(end); // 最終地点を照らす
}
